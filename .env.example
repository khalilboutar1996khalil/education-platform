# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
# Spring Boot reads .env automatically (see spring.config.import in application.yml).

# Database (dev defaults to eduflow/eduflow on localhost if unset)
DB_URL=jdbc:postgresql://localhost:5432/eduflow
DB_USERNAME=eduflow
DB_PASSWORD=eduflow

# Profile: dev | prod
# SPRING_PROFILES_ACTIVE=dev

# JWT signing key (added in Step 2). Generate one with: openssl rand -base64 32
# JWT_SECRET=

# SonarQube — used by Gradle, export them in your shell instead of putting them here:
#   export SONAR_TOKEN=...
#   export SONAR_HOST_URL=http://localhost:9000
