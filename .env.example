# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
# Spring Boot reads .env automatically (see spring.config.import in application.yml).

# Database (dev defaults to eduflow/eduflow on localhost if unset)
DB_URL=jdbc:postgresql://localhost:5432/eduflow
DB_USERNAME=eduflow
DB_PASSWORD=eduflow

# Profile: dev | prod
# SPRING_PROFILES_ACTIVE=dev

# JWT signing key. Generate one with: openssl rand -base64 32
# Required in prod; dev falls back to a public throwaway key.
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# SonarQube — used by Gradle, export them in your shell instead of putting them here:
#   export SONAR_TOKEN=...
#   export SONAR_HOST_URL=http://localhost:9000

# E-mail (optional). Without these lines, e-mails are only written to the logs.
# Gmail: create an app password at https://myaccount.google.com/apppasswords (spaces removed)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# APP_MAIL_FROM=
