# Production settings for compose.prod.yaml.
# On the server: cp .env.production.example .env, then fill in every value. Never commit .env.

# ---------- Address ----------
# Without a domain: the server's IP, plain HTTP
SITE_ADDRESS=:80
PUBLIC_URL=http://203.0.113.10
# With a domain (HTTPS is then automatic):
# SITE_ADDRESS=eduflow.example.dz
# PUBLIC_URL=https://eduflow.example.dz

# ---------- Secrets (generate each with: openssl rand -base64 32) ----------
DB_PASSWORD=
JWT_SECRET=

# ---------- First administrator ----------
# Created on the first start only; can be removed from this file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# ---------- E-mail (optional) ----------
# Without these lines, e-mails are only written to the logs.
# Example with Brevo (free tier: 300 e-mails/day):
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# APP_MAIL_FROM=no-reply@eduflow.example.dz

# ---------- Location of the Angular project (default: ../education-platform-front) ----------
# FRONTEND_DIR=../education-platform-front
